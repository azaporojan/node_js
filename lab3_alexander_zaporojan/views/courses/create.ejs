<%- include('../partials/header') %>

<h2>Добавить курс</h2>

<% if (errors.length > 0) { %>
    <ul class="errors">
        <% for (const error of errors) { %>
            <li><%= error %></li>
        <% } %>
    </ul>
<% } %>

<form class="form" action="/courses" method="POST">
    <label for="title">Название дисциплины</label>
    <input type="text" id="title" name="title" value="<%= course.title %>">

    <label for="teacher">Преподаватель</label>
    <input type="text" id="teacher" name="teacher" value="<%= course.teacher %>">

    <label for="credits">Количество кредитов</label>
    <input type="text" id="credits" name="credits" value="<%= course.credits %>">

    <label for="semester">Семестр</label>
    <input type="text" id="semester" name="semester" value="<%= course.semester %>">

    <label for="description">Описание</label>
    <textarea id="description" name="description" rows="4"><%= course.description %></textarea>

    <button class="btn btn-add" type="submit">Сохранить</button>
    <a class="btn btn-gray" href="/courses">Отмена</a>
</form>

<%- include('../partials/footer') %>
