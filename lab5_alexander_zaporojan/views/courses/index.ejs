<%- include('../partials/header') %>

<h2>Курсы</h2>

<% if (currentUser && currentUser.role === 'admin') { %>
    <a class="btn btn-add" href="/courses/new">Добавить курс</a>
<% } %>

<form class="filter" action="/courses" method="GET">
    <input type="text" name="search" placeholder="Поиск по названию" value="<%= search %>">
    <select name="teacherId">
        <option value="">Все преподаватели</option>
        <% for (const teacher of teachers) { %>
            <option value="<%= teacher.id %>" <% if (Number(teacherId) === teacher.id) { %>selected<% } %>><%= teacher.name %></option>
        <% } %>
    </select>
    <select name="semester">
        <option value="">Все семестры</option>
        <% for (let i = 1; i <= 8; i++) { %>
            <option value="<%= i %>" <% if (Number(semester) === i) { %>selected<% } %>>Семестр <%= i %></option>
        <% } %>
    </select>
    <button class="btn" type="submit">Найти</button>
    <a class="btn btn-gray" href="/courses">Сбросить</a>
</form>

<% if (courses.length === 0) { %>
    <p class="empty">Курсы не найдены</p>
<% } else { %>
    <table>
        <thead>
            <tr>
                <th>Название</th>
                <th>Преподаватель</th>
                <th>Кредиты</th>
                <th>Семестр</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            <% for (const course of courses) { %>
                <tr>
                    <td><%= course.title %></td>
                    <td><%= course.Teacher.name %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.semester %></td>
                    <td class="actions">
                        <a class="btn btn-view" href="/courses/<%= course.id %>">Просмотр</a>
                        <% if (currentUser && currentUser.role === 'admin') { %>
                        <a class="btn btn-edit" href="/courses/<%= course.id %>/edit">Редактировать</a>
                        <form action="/courses/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Вы действительно хотите удалить этот курс?')">
                            <button class="btn btn-delete" type="submit">Удалить</button>
                        </form>
                        <% } %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>
